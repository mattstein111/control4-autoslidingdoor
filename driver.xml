  <config>
    <script file="driver.lua"/>
    <documentation file="www/documentation.html"/>
    <conditionals>
      <conditional>
        <id>1</id>
        <name>Mode</name>
        <type>LIST</type>
        <condition_statement>Mode</condition_statement>
        <description>NAME Mode is LOGIC STRING</description>
        <items>
          <item>Off</item>
          <item>Hold</item>
          <item>Auto</item>
        </items>
      </conditional>
      <conditional>
        <id>2</id>
        <name>Door State</name>
        <type>LIST</type>
        <condition_statement>Door State</condition_statement>
        <description>NAME Door is LOGIC STRING</description>
        <items>
          <item>Open</item>
          <item>Closed</item>
          <item>Unknown</item>
        </items>
      </conditional>
    </conditionals>
    <properties>
      <property>
        <name>Driver Version</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Debug Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
        <readonly>false</readonly>
        <tooltip>Verbose Lua output for troubleshooting.</tooltip>
      </property>
      <property>
        <name>Mode</name>
        <default>Off</default>
        <type>STRING</type>
        <readonly>true</readonly>
        <tooltip>Current sustained mode (Off / Hold / Auto). Read-only mirror of the MODE variable.</tooltip>
      </property>
      <property>
        <name>Door State</name>
        <default>Unknown</default>
        <type>STRING</type>
        <readonly>true</readonly>
        <tooltip>Current door position from the contact sensor. Read-only mirror of the DOOR_STATE variable.</tooltip>
      </property>
      <property>
        <name>Contact Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
        <tooltip>Reports whether the door contact sensor binding is wired.</tooltip>
      </property>
      <property>
        <name>Default Open Duration (s)</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>5</default>
        <minimum>1</minimum>
        <maximum>600</maximum>
        <tooltip>How long Relay A is held closed by the 'Open Door' action when no override is supplied. (default 5)</tooltip>
      </property>
      <property>
        <name>Hold Duration (s)</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>0</default>
        <minimum>0</minimum>
        <maximum>3600</maximum>
        <tooltip>If non-zero, Hold mode auto-releases to Off after this many seconds. 0 = unlimited (Hold stays until explicit release). (default 0)</tooltip>
      </property>
      <property>
        <name>Still Open Time (s)</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>0</default>
        <minimum>0</minimum>
        <maximum>3600</maximum>
        <tooltip>If non-zero, fires the 'Still Open' event when the door has been continuously open this many seconds. 0 = disabled. (default 0)</tooltip>
      </property>
      <property>
        <name>Invert Open Door Relay</name>
        <type>LIST</type>
        <items>
          <item>No</item>
          <item>Yes</item>
        </items>
        <default>No</default>
        <readonly>false</readonly>
        <tooltip>Set to Yes if the open relay must be OPENED to slide the door open (normally-closed wiring). (default No)</tooltip>
      </property>
      <property>
        <name>Invert Arm Motion Relay</name>
        <type>LIST</type>
        <items>
          <item>No</item>
          <item>Yes</item>
        </items>
        <default>No</default>
        <readonly>false</readonly>
        <tooltip>Set to Yes if the arm-motion relay must be OPENED to arm the motion sensors. (default No)</tooltip>
      </property>
      <property>
        <name>Invert Door Contact</name>
        <type>LIST</type>
        <items>
          <item>No</item>
          <item>Yes</item>
        </items>
        <default>No</default>
        <readonly>false</readonly>
        <tooltip>Set to Yes if the contact OPENS when the door is open (normally-closed sensor). (default No)</tooltip>
      </property>
      <property>
        <name>Door Contact Debounce (ms)</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>250</default>
        <minimum>1</minimum>
        <maximum>1000</maximum>
        <tooltip>Ignore additional contact state changes for this many milliseconds after a change, to suppress contact bounce. (default 250)</tooltip>
      </property>
      <property>
        <name>Long Press Threshold (ms)</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>1000</default>
        <minimum>200</minimum>
        <maximum>3000</maximum>
        <tooltip>How long the button must be held before the gesture decoder triggers Hold mode. Only used by 'On Button Pressed' / 'On Button Released' actions. (default 1000)</tooltip>
      </property>
      <property>
        <name>Double Click Window (ms)</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>400</default>
        <minimum>100</minimum>
        <maximum>1000</maximum>
        <tooltip>How long the gesture decoder waits after a short press for a possible second press (double-click). Only used by 'On Button Pressed' / 'On Button Released' actions. (default 400)</tooltip>
      </property>
      <property>
        <name>Off LED Color</name>
        <type>COLOR_SELECTOR</type>
        <default>0,0,200</default>
        <readonly>false</readonly>
        <tooltip>Color of bound keypad button LEDs when current mode is Off.</tooltip>
      </property>
      <property>
        <name>Hold LED Color</name>
        <type>COLOR_SELECTOR</type>
        <default>200,200,0</default>
        <readonly>false</readonly>
        <tooltip>Color of bound keypad button LEDs when current mode is Hold.</tooltip>
      </property>
      <property>
        <name>Auto LED Color</name>
        <type>COLOR_SELECTOR</type>
        <default>0,200,0</default>
        <readonly>false</readonly>
        <tooltip>Color of bound keypad button LEDs when current mode is Auto.</tooltip>
      </property>
    </properties>
    <commands>
      <command>
        <name>OPEN_DEFAULT</name>
        <description>Open NAME for default duration</description>
      </command>
      <command>
        <name>OPEN_FOR_N</name>
        <description>Open NAME for N seconds</description>
        <params>
          <param>
            <name>Seconds</name>
            <type>RANGED_INTEGER</type>
            <minimum>1</minimum>
            <maximum>600</maximum>
            <default>5</default>
          </param>
        </params>
      </command>
      <command>
        <name>SET_MODE_OFF</name>
        <description>Set NAME mode to Off</description>
      </command>
      <command>
        <name>SET_MODE_HOLD</name>
        <description>Set NAME mode to Hold</description>
      </command>
      <command>
        <name>SET_MODE_AUTO</name>
        <description>Set NAME mode to Auto</description>
      </command>
      <command>
        <name>CANCEL_OPEN</name>
        <description>Cancel any pending Open-for-N timer on NAME</description>
      </command>
      <command>
        <name>BUTTON_PRESSED</name>
        <description>Notify NAME that a bound physical button has been pressed (drives gesture decoding)</description>
      </command>
      <command>
        <name>BUTTON_RELEASED</name>
        <description>Notify NAME that a bound physical button has been released (drives gesture decoding)</description>
      </command>
    </commands>
    <actions>
      <action>
        <name>Open Door</name>
        <command>OPEN_DEFAULT</command>
      </action>
      <action>
        <name>Open Door for N Seconds</name>
        <command>OPEN_FOR_N</command>
      </action>
      <action>
        <name>Set Mode to Off</name>
        <command>SET_MODE_OFF</command>
      </action>
      <action>
        <name>Set Mode to Hold (Hold Open)</name>
        <command>SET_MODE_HOLD</command>
      </action>
      <action>
        <name>Set Mode to Auto (Motion Sensors)</name>
        <command>SET_MODE_AUTO</command>
      </action>
      <action>
        <name>Cancel Pending Open</name>
        <command>CANCEL_OPEN</command>
      </action>
      <action>
        <name>On Button Pressed</name>
        <command>BUTTON_PRESSED</command>
      </action>
      <action>
        <name>On Button Released</name>
        <command>BUTTON_RELEASED</command>
      </action>
    </actions>
  </config>
